[Unit]
Description=StreamHub Nginx RTMP ingest service
After=network-online.target streamhub.service
Wants=network-online.target streamhub.service

[Service]
Type=simple
User=streamhub
Group=streamhub
WorkingDirectory=/opt/StreamHub
RuntimeDirectory=streamhub-rtmp
RuntimeDirectoryMode=0750
ExecStartPre=/usr/sbin/nginx -t -c /opt/StreamHub/services/nginx-rtmp.conf -p /opt/StreamHub
ExecStart=/usr/sbin/nginx -g "daemon off;" -c /opt/StreamHub/services/nginx-rtmp.conf -p /opt/StreamHub
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGQUIT
TimeoutStopSec=15
Restart=on-failure
RestartSec=2
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/StreamHub/data /run/streamhub-rtmp
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
