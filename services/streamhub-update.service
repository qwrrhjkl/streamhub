[Unit]
Description=StreamHub verified GitHub source updater
After=network-online.target
Wants=network-online.target
ConditionPathIsDirectory=/opt/StreamHub/.git

[Service]
Type=oneshot
User=root
Group=root
Environment=STREAMHUB_ROOT=/opt/StreamHub
ExecStart=/usr/bin/bash /opt/StreamHub/scripts/update-from-github.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/StreamHub /var/backups/streamhub /run/lock
UMask=0027
TimeoutStartSec=600
TimeoutStopSec=120
